{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/rollup-summaries", "schedule": "15 2 * * *" },
    { "path": "/api/cron/purge-detailed-logs", "schedule": "30 2 * * *" },
    { "path": "/api/cron/purge-photos", "schedule": "45 2 * * *" }
    ,{ "path": "/api/cron/process-deletions", "schedule": "0 3 * * *" },
    { "path": "/api/cron/deletion-reminders", "schedule": "15 3 * * *" }
  ]
}
